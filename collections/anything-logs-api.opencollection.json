{
  "opencollection": "1.0.0",
  "info": {
    "name": "Anything Assets Logs API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "Logs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Read recent development logs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/v0/api/projects/:projectGroupId/logs",
            "params": [
              {
                "name": "projectGroupId",
                "value": "",
                "type": "path"
              },
              {
                "name": "level",
                "value": "",
                "type": "query"
              },
              {
                "name": "search",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Returns recent development logs for a project, optionally filtered by level or message text."
        }
      ]
    }
  ],
  "bundled": true
}