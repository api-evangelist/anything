{
  "opencollection": "1.0.0",
  "info": {
    "name": "Anything Assets Secrets API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "Secrets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List secrets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/v0/api/projects/:projectGroupId/secrets",
            "params": [
              {
                "name": "projectGroupId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Returns the configured secrets for a project without exposing plaintext values."
        },
        {
          "info": {
            "name": "Add secrets",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/v0/api/projects/:projectGroupId/secrets",
            "params": [
              {
                "name": "projectGroupId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Adds one or more secrets to a project. Send a single secret object or a bulk array."
        },
        {
          "info": {
            "name": "Delete a secret",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "/v0/api/projects/:projectGroupId/secrets/:secretId",
            "params": [
              {
                "name": "projectGroupId",
                "value": "",
                "type": "path"
              },
              {
                "name": "secretId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Removes a secret from the project."
        }
      ]
    }
  ],
  "bundled": true
}